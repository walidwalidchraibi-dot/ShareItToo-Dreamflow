  "findings": [
    {
      "id": "RW12-P0-POST-SERVICE-STALE-SUCCESS-UI-001",
      "state": "resolved-and-tested",
      "resolution": "A red-first widget test proved that Account A could render password success after Account B became active; the screen now requires a stable post-service security epoch before popup creation and before login navigation."
    },
    {
      "id": "RW12-P1-AMBIGUOUS-LOCAL-SESSION-ABSENCE-002",
      "state": "resolved-and-tested",
      "resolution": "Password success now uses a dedicated containsKey-based absence check, so active, successor, malformed, opaque or unreadable session state fails closed instead of becoming empty truth."
    },
    {
      "id": "RW12-P1-WEB-SECURITY-EPOCH-NOTIFICATION-GAP-003",
      "state": "resolved-and-tested",
      "resolution": "The Web persistence watch set now includes account_security_state_v1, allowing supported security-state notifications to invalidate the same UI epoch rather than being filtered out."
    },
    {
      "id": "RW12-P0-AMBIGUOUS-PASSWORD-RESULT-MESSAGING-004",
      "state": "resolved-and-tested",
      "resolution": "Explicit allowlisted 4xx rejection, server-confirmed local-finalization failure, and timeout/transport/5xx unknown outcome now have distinct typed results and UI wording; unknown outcomes conditionally remove only the exact invoking Account A marker and never successor Account B."
    }
  ],
