  "findings": [
    {
      "id": "RW16-P0-PROFILE-LOGOUT-OWNER-RACE-001",
      "state": "resolved-and-tested",
      "resolution": "Profile logout captures the exact A session/profile owner before the confirmation await, revalidates it before cleanup, and requires a current completion before preview mutation or navigation."
    },
    {
      "id": "RW16-P0-LOGIN-STALE-SESSION-CLEAR-RACE-002",
      "state": "resolved-and-tested",
      "resolution": "Login bootstrap and guest continuation now bind an owner or confirmed-empty epoch; a delayed A result cannot clear or navigate under B."
    },
    {
      "id": "RW16-P0-SESSION-MUTATION-TOCTOU-003",
      "state": "resolved-and-tested",
      "resolution": "Every app-owned session write/removal is serialized; exact owner comparison occurs inside the queue and every successful mutation ratchets the epoch."
    },
    {
      "id": "RW16-P0-CURRENT-PROFILE-BROAD-CLEAR-004",
      "state": "resolved-and-tested",
      "resolution": "Session transitions remove current profile data only after an id-plus-email comparison in the profile mutation queue, preserving B and malformed unknown state."
    },
    {
      "id": "RW16-P0-A-DIALOG-B-NAVIGATOR-RACE-005",
      "state": "resolved-and-tested",
      "resolution": "The A logout confirmation is removed by its exact tracked route identity after A to B; a newer B-owned dialog remains visible in the deterministic widget test."
    }
  ],
