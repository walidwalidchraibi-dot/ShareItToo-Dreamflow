  "findings": [
    {
      "id": "RW8-P0-CALLER-IDENTITY-SPOOF-001",
      "state": "resolved-and-tested",
      "resolution": "Review submission requires the exact current authenticated participant instead of trusting caller reviewer ids."
    },
    {
      "id": "RW8-P0-BOOKING-CONTEXT-DRIFT-002",
      "state": "resolved-and-tested",
      "resolution": "Completion direction counterparty item and needsReview state are exact and the booking bytes are rechecked before write."
    },
    {
      "id": "RW8-P0-CORRUPTION-AS-EMPTY-003",
      "state": "resolved-and-tested",
      "resolution": "Malformed classic or multi-review documents fail closed and preserve exact bytes."
    },
    {
      "id": "RW8-P0-FAKE-READ-SEEDING-004",
      "state": "resolved-and-tested",
      "resolution": "A missing classic document stays empty; demo reputation requires explicit QA bootstrap."
    },
    {
      "id": "RW8-P0-DUPLICATE-CONTEXT-005",
      "state": "resolved-and-tested",
      "resolution": "Duplicate ids and booking/reviewer contexts close the document and concurrent duplicates persist exactly once."
    },
    {
      "id": "RW8-P0-LOST-UPDATE-CONCURRENCY-006",
      "state": "resolved-and-tested",
      "resolution": "A fixed-order booking and review queue serializes distinct review writes without lost updates."
    },
    {
      "id": "RW8-P0-STORAGE-FAILURE-HISTORY-LOSS-007",
      "state": "resolved-and-tested",
      "resolution": "Verified write failure restores exact prior bytes and leaves the queue recoverable."
    },
    {
      "id": "RW8-P0-UNBOUNDED-OR-PRUNED-HISTORY-008",
      "state": "resolved-and-tested",
      "resolution": "Each review document is bounded at 1000 and overflow rejects without pruning history."
    },
    {
      "id": "RW8-P0-PRIVACY-EXPORT-RETENTION-SCOPE-009",
      "state": "resolved-and-tested",
      "resolution": "Export is current-account scoped and shared public retention is explicit without an invented period."
    },
    {
      "id": "RW8-P1-FALSE-SUCCESS-OR-SPINNER-010",
      "state": "resolved-and-tested",
      "resolution": "Submission preserves input for retry and profile reads expose a bounded retry state."
    }
  ],
