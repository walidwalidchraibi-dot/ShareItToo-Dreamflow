  "findings": [
    {
      "id": "RW5-P0-BLOCKED-USERS-CROSS-PRINCIPAL-001",
      "state": "resolved-and-tested",
      "resolution": "Block state is opaque-principal scoped and corrupt state fails closed."
    },
    {
      "id": "RW5-P0-REPORTS-CROSS-PRINCIPAL-002",
      "state": "resolved-and-tested",
      "resolution": "Local reports are bounded inside the reporter principal bucket."
    },
    {
      "id": "RW5-P0-DISCOVERY-PROFILE-CROSS-PRINCIPAL-003",
      "state": "resolved-and-tested",
      "resolution": "Hidden listings and feedback signals no longer transfer between accounts."
    },
    {
      "id": "RW5-P0-COMMUNICATION-STATE-CROSS-PRINCIPAL-004",
      "state": "resolved-and-tested",
      "resolution": "Muted threads and communication preferences are principal scoped."
    },
    {
      "id": "RW5-P0-LEGACY-MISATTRIBUTION-005",
      "state": "resolved-and-tested",
      "resolution": "Unattributed legacy state is guest-only and attributed muted state requires an exact owner."
    },
    {
      "id": "RW5-P0-EXPORT-DELETION-SCOPE-006",
      "state": "resolved-and-tested",
      "resolution": "Export and confirmed deletion affect only the current principal."
    },
    {
      "id": "RW5-P1-IDENTIFIER-DISCLOSURE-007",
      "state": "resolved-and-tested",
      "resolution": "Canonical principal keys contain no raw account identifier or credential."
    },
    {
      "id": "RW5-P1-SESSION-TRANSITION-008",
      "state": "resolved-and-tested",
      "resolution": "Invoked mutations retain their captured owner and open surfaces clear stale state."
    },
    {
      "id": "RW5-P1-CORRUPTION-QUARANTINE-009",
      "state": "resolved-and-tested",
      "resolution": "Malformed legacy and principal buckets are preserved and fail closed."
    },
    {
      "id": "RW5-P1-BOUNDED-REGISTRY-010",
      "state": "resolved-and-tested",
      "resolution": "The registry rejects overflow without evicting earlier principal state."
    }
  ],
