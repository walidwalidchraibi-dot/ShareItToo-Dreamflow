  "findings": [
    {
      "id": "RW9-P0-CALLER-PROTECTED-FIELD-OVERWRITE-001",
      "state": "resolved-and-tested",
      "resolution": "User-facing writes use an exact mutable-field allowlist and cannot submit protected account fields."
    },
    {
      "id": "RW9-P0-STALE-SNAPSHOT-DATA-LOSS-002",
      "state": "resolved-and-tested",
      "resolution": "Profile surfaces patch the latest stored document instead of replacing it with stale or partial User snapshots."
    },
    {
      "id": "RW9-P0-SESSION-IDENTITY-DRIFT-003",
      "state": "resolved-and-tested",
      "resolution": "Every profile mutation requires and rechecks the exact current authenticated account."
    },
    {
      "id": "RW9-P0-CORRUPTION-AS-DEFAULT-004",
      "state": "resolved-and-tested",
      "resolution": "Malformed or duplicate account documents fail closed and retain exact raw bytes without read-time normalization."
    },
    {
      "id": "RW9-P0-PAIRED-DOCUMENT-LOSS-005",
      "state": "resolved-and-tested",
      "resolution": "Serialized verified paired writes restore both exact previous documents after an observed failure."
    },
    {
      "id": "RW9-P0-LOST-UPDATE-CONCURRENCY-006",
      "state": "resolved-and-tested",
      "resolution": "Disjoint concurrent patches serialize against the latest pair and retain every accepted field update."
    },
    {
      "id": "RW9-P0-UNBOUNDED-OR-PRUNED-PROFILES-007",
      "state": "resolved-and-tested",
      "resolution": "The account cache and fields are bounded and overflow rejects without deleting another profile."
    },
    {
      "id": "RW9-P0-FOREIGN-DEACTIVATION-008",
      "state": "resolved-and-tested",
      "resolution": "Local anonymization requires the exact current account and preserves every other cached profile."
    },
    {
      "id": "RW9-P0-PRIVACY-EXPORT-SCOPE-009",
      "state": "resolved-and-tested",
      "resolution": "The local profile export includes only the current account and excludes other cache entries and auth-session material."
    },
    {
      "id": "RW9-P1-FAKE-VERIFICATION-OR-FALSE-SUCCESS-010",
      "state": "resolved-and-tested",
      "resolution": "Local UI cannot change email or simulate verification and failed profile writes retain a retryable surface."
    }
  ],
