  "findings": [
    {
      "id": "RW10-P0-LOCAL-PASSWORD-SUCCESS-SIMULATION-001",
      "state": "resolved-and-tested",
      "resolution": "Offline password fields and timed fake success were removed; only the server-authoritative service can return success."
    },
    {
      "id": "RW10-P0-LOCAL-TWO-FACTOR-PROTECTION-CLAIM-002",
      "state": "resolved-and-tested",
      "resolution": "Both security surfaces expose an unavailable explanation without switches, methods, codes or local persistence."
    },
    {
      "id": "RW10-P0-SEEDED-SESSION-DEVICE-TRUTH-003",
      "state": "resolved-and-tested",
      "resolution": "Seeded device records and local session-list persistence were retired; only a validated server list can render."
    },
    {
      "id": "RW10-P0-PARTIAL-SERVER-SESSION-SALVAGE-004",
      "state": "resolved-and-tested",
      "resolution": "The repository and service reject malformed, duplicate, over-capacity or contradictory whole session lists."
    },
    {
      "id": "RW10-P0-SESSION-RESPONSE-PRINCIPAL-DRIFT-005",
      "state": "resolved-and-tested",
      "resolution": "Every response is rechecked against the exact invoking account id, session id and normalized email."
    },
    {
      "id": "RW10-P0-BROAD-SUCCESSOR-SESSION-CLEAR-006",
      "state": "resolved-and-tested",
      "resolution": "Password change and logout-all use an exact conditional local clear and preserve a different or successor session."
    },
    {
      "id": "RW10-P0-CURRENT-SESSION-FOREIGN-REVOKE-007",
      "state": "resolved-and-tested",
      "resolution": "The current session id is rejected before the foreign-device revoke route can be called."
    },
    {
      "id": "RW10-P1-STALE-ASYNC-SECURITY-UI-008",
      "state": "resolved-and-tested",
      "resolution": "Session events clear secrets and stale state immediately; revision and epoch guards discard old async completions."
    },
    {
      "id": "RW10-P1-NONRETRYABLE-SESSION-LOAD-FAILURE-009",
      "state": "resolved-and-tested",
      "resolution": "Invalid or failed server session loads retain a visible error and explicit deterministic retry."
    },
    {
      "id": "RW10-P1-LEGACY-SECURITY-READ-MUTATION-010",
      "state": "resolved-and-tested",
      "resolution": "Retired legacy preview bytes are ignored and preserved exactly without read-time rewrite, seeding or deletion."
    },
    {
      "id": "RW10-P1-SECRET-SCAN-FIXTURE-011",
      "state": "resolved-and-tested",
      "resolution": "Synthetic static password properties were replaced by runtime-built fixtures; the published historical tuple is reviewed exactly and cannot permit current-tree findings."
    }
  ],
