  "findings": [
    {
      "id": "RW17-P0-PREFLIGHT-UNAVAILABLE-AS-EMPTY-001",
      "state": "resolved-and-tested",
      "resolution": "Transport and invalid preflight responses are typed unavailable states and can never become a server-confirmed empty blocker list."
    },
    {
      "id": "RW17-P0-DELETION-RESULT-COLLAPSE-002",
      "state": "resolved-and-tested",
      "resolution": "Only six exact status-code-plus-error-code contracts are definite rejection; 408, intermediary, unstructured 4xx and transport failures remain outcome-unknown."
    },
    {
      "id": "RW17-P0-CONFIRMED-LOCAL-FAILURE-003",
      "state": "resolved-and-tested",
      "resolution": "Server confirmation followed by local finalization failure has its own typed result and cannot display account-not-deleted."
    },
    {
      "id": "RW17-P0-DELETED-A-SUCCESSOR-B-CLEANUP-004",
      "state": "resolved-and-tested",
      "resolution": "Confirmed cleanup addresses A by explicit identity and treats a stable active B session, profile, principal buckets and device-scoped Firebase installation as preserved success without enabling A navigation."
    },
    {
      "id": "RW17-P0-AWAIT-OWNER-EPOCH-RESULT-RACE-005",
      "state": "resolved-and-tested",
      "resolution": "The screen captures A synchronously and revalidates before remote calls, result presentation and navigation; delayed A results cannot render under B."
    },
    {
      "id": "RW17-P0-A-DIALOG-B-NAVIGATOR-RACE-006",
      "state": "resolved-and-tested",
      "resolution": "Each A deletion dialog is removed by its exact tracked route identity; a newer B-owned dialog remains visible."
    }
  ],
