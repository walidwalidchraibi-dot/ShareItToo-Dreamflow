  "findings": [
    {
      "id": "RW6-P0-STALE-PROFILE-AUTHORIZATION-001",
      "state": "resolved-and-tested",
      "resolution": "Operational access requires a cached profile and matching current auth session."
    },
    {
      "id": "RW6-P0-FOREIGN-OPERATIONAL-ID-ACCESS-002",
      "state": "resolved-and-tested",
      "resolution": "Public reads and mutations bind caller ids to the current account and booking participant."
    },
    {
      "id": "RW6-P0-TWO-PARTY-THREAD-DELETION-003",
      "state": "resolved-and-tested",
      "resolution": "Thread deletion is a current-user tombstone that preserves counterparty access."
    },
    {
      "id": "RW6-P0-LEGACY-NOTIFICATION-MISATTRIBUTION-004",
      "state": "resolved-and-tested",
      "resolution": "Unattributed legacy notifications remain preserved, unassigned and excluded."
    },
    {
      "id": "RW6-P0-CORRUPT-TO-EMPTY-REWRITE-005",
      "state": "resolved-and-tested",
      "resolution": "Strict decoders fail closed and preserve exact raw operational documents."
    },
    {
      "id": "RW6-P0-SILENT-HISTORY-PRUNING-006",
      "state": "resolved-and-tested",
      "resolution": "Bounded full stores reject writes without removing accepted history."
    },
    {
      "id": "RW6-P0-LOST-UPDATE-CONCURRENCY-007",
      "state": "resolved-and-tested",
      "resolution": "Operational mutation queues serialize verified read-modify-write operations."
    },
    {
      "id": "RW6-P0-BOOKING-SELECTION-CROSS-PRINCIPAL-008",
      "state": "resolved-and-tested",
      "resolution": "Selections use bounded opaque account or guest buckets and quarantine corrupt legacy state."
    },
    {
      "id": "RW6-P0-PRIVACY-EXPORT-DELETION-SCOPE-009",
      "state": "resolved-and-tested",
      "resolution": "Export and both deletion paths apply current-account and participant lifecycle truth."
    },
    {
      "id": "RW6-P1-HANDOVER-HELPER-FOREIGN-ACCESS-010",
      "state": "resolved-and-tested",
      "resolution": "Failure counters, banners and handover metadata require a current request participant."
    },
    {
      "id": "RW6-P1-SESSION-CHANGE-DURING-ASYNC-WORK-011",
      "state": "resolved-and-tested",
      "resolution": "Queued and remote work rechecks the captured session before persistence or delivery."
    },
    {
      "id": "RW6-P1-STALE-COMMUNICATION-UI-012",
      "state": "resolved-and-tested",
      "resolution": "Open communication surfaces clear old state and verify the account after async loads."
    }
  ],
