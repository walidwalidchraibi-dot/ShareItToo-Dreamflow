  "findings": [
    {
      "id": "RW7-P0-FOREIGN-LISTING-MUTATION-001",
      "state": "resolved-and-tested",
      "resolution": "Local listing mutations require the current session and exact stored owner."
    },
    {
      "id": "RW7-P0-STALE-PROFILE-AUTHORIZATION-002",
      "state": "resolved-and-tested",
      "resolution": "A cached profile without its matching auth session cannot authorize a listing write."
    },
    {
      "id": "RW7-P0-PARTIAL-CORRUPTION-REWRITE-003",
      "state": "resolved-and-tested",
      "resolution": "One malformed listing closes the whole document and preserves exact prior bytes."
    },
    {
      "id": "RW7-P0-DUPLICATE-ID-AMBIGUITY-004",
      "state": "resolved-and-tested",
      "resolution": "Duplicate listing identifiers are rejected as ambiguous without sanitization."
    },
    {
      "id": "RW7-P0-UNAPPROVED-60-DAY-DELETION-005",
      "state": "resolved-and-tested",
      "resolution": "Ended listings remain retained until an approved retention rule exists."
    },
    {
      "id": "RW7-P0-LOST-UPDATE-CONCURRENCY-006",
      "state": "resolved-and-tested",
      "resolution": "One listing queue serializes verified read-modify-write operations."
    },
    {
      "id": "RW7-P0-STALE-EDIT-AND-MISSING-UPSERT-007",
      "state": "resolved-and-tested",
      "resolution": "Stale revisions and missing local mutation targets fail closed without upsert."
    },
    {
      "id": "RW7-P0-STORAGE-FAILURE-MEDIA-PRUNING-008",
      "state": "resolved-and-tested",
      "resolution": "Capacity and storage failures preserve prior bytes and never strip retained media."
    },
    {
      "id": "RW7-P0-PRIVACY-EXPORT-DELETION-SCOPE-009",
      "state": "resolved-and-tested",
      "resolution": "Export and confirmed local deletion apply current-owner listing lifecycle truth."
    },
    {
      "id": "RW7-P1-STALE-OWNER-UI-FALSE-SUCCESS-010",
      "state": "resolved-and-tested",
      "resolution": "Owner surfaces clear stale accounts and report success only after verified reload."
    }
  ],
