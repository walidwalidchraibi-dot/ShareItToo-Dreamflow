POSTGRES_PASSWORD=replace-with-an-independent-staging-password
JWT_SECRET=replace-with-an-independent-staging-secret-of-at-least-32-characters
CORS_ORIGINS=https://staging.shareittoo.com
PUBLIC_BASE_URL=https://staging.shareittoo.com/api/v1
APP_PUBLIC_URL=https://staging.shareittoo.com
PUBLIC_COMPLIANCE_APPROVED=false
PUBLIC_SUPPORT_EMAIL=
PUBLIC_PRIVACY_EMAIL=
PUBLIC_LEGAL_PROVIDER_NAME=
PUBLIC_LEGAL_PROVIDER_ADDRESS=
PUBLIC_PRIVACY_EFFECTIVE_DATE=
# Staging documents stay visibly marked as test documents.
FINANCIAL_DOCUMENTS_LIVE_ISSUANCE_APPROVED=false
FINANCIAL_DOCUMENTS_SIT_FEE_TAX_LABEL=
# Server-only key for the Places proxy. Never expose this key to app builds.
GOOGLE_MAPS_SERVER_API_KEY=
STAGING_API_PORT=18080
MAIL_TRANSPORT=memory
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=ShareItToo Staging <contact@shareittoo.com>
MAIL_REPLY_TO=contact@shareittoo.com
APP_VERSION=development
APP_COMMIT=unknown
APP_BUILD_TIME=unknown
BOOKING_PILOT_MODE=pilot
# The current internal candidate is V4-compatible and migrations are applied
# transactionally during API startup. Keep production separately fail-closed.
PRIVATE_PILOT_V4_ENABLED=true
PUSH_TRANSPORT=memory
PUSH_WEBHOOK_URL=
PUSH_WEBHOOK_TOKEN=
FIREBASE_PROJECT_ID=
# Enable only after the selected sign-in providers are configured in Firebase.
FIREBASE_AUTH_ENABLED=false
# Enable separately after Phone provider, SMS regions and app verification are reviewed.
FIREBASE_PHONE_VERIFICATION_ENABLED=false
# Absolute host path; mounted read-only into the API container. Never commit the JSON file.
FIREBASE_SERVICE_ACCOUNT_HOST_FILE=
NOTIFICATION_WORKER_INTERVAL_MS=1000
NOTIFICATION_BATCH_SIZE=50
NOTIFICATION_MAX_ATTEMPTS=5
