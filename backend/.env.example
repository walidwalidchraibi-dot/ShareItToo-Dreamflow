POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://shareittoo:change-me@postgres:5432/shareittoo
JWT_SECRET=replace-with-at-least-32-random-characters
STAFF_ELEVATION_MINUTES=10
CORS_ORIGINS=https://shareittoo.com,https://www.shareittoo.com,https://srv1580960.hstgr.cloud
PUBLIC_BASE_URL=https://shareittoo.com/api/v1
UPLOAD_DIR=/data/uploads
PORT=8080
APP_PUBLIC_URL=https://shareittoo.com
PUBLIC_COMPLIANCE_APPROVED=false
PUBLIC_SUPPORT_EMAIL=
PUBLIC_PRIVACY_EMAIL=
PUBLIC_LEGAL_PROVIDER_NAME=
PUBLIC_LEGAL_PROVIDER_ADDRESS=
PUBLIC_PRIVACY_EFFECTIVE_DATE=
# Server-only key for the Places proxy. Never expose this key to app builds.
GOOGLE_MAPS_SERVER_API_KEY=
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=ShareItToo <contact@shareittoo.com>
MAIL_REPLY_TO=contact@shareittoo.com
APP_VERSION=development
APP_COMMIT=unknown
APP_BUILD_TIME=unknown
REQUIRE_RELEASE_IDENTITY=true
REQUIRE_RECENT_RESTORE_CHECK=true
BOOKING_PILOT_MODE=off
PUSH_TRANSPORT=disabled
PUSH_WEBHOOK_URL=
PUSH_WEBHOOK_TOKEN=
FIREBASE_PROJECT_ID=
# Enables verification of Firebase Google, Apple, and Facebook ID tokens.
FIREBASE_AUTH_ENABLED=false
# Enables only authenticated Firebase SMS ownership confirmation.
FIREBASE_PHONE_VERIFICATION_ENABLED=false
# Absolute host path; mounted read-only into the API container. Never commit the JSON file.
FIREBASE_SERVICE_ACCOUNT_HOST_FILE=
NOTIFICATION_WORKER_INTERVAL_MS=5000
NOTIFICATION_BATCH_SIZE=25
NOTIFICATION_MAX_ATTEMPTS=5
PAYMENT_TRANSPORT=disabled
PAYMENT_CURRENCY=EUR
PAYMENT_PILOT_USER_IDS=
PAYOUT_HOLD_HOURS=48
STRIPE_CONNECT_COUNTRY=DE
STRIPE_LIVEMODE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=
